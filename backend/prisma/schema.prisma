generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  username            String               @unique
  displayName         String               @map("display_name")
  avatar              String?
  bio                 String?
  tokens              Token[]
  socialLinks         SocialLink[]
  stream              Stream?
  isTotpEnabled       Boolean              @default(false) @map("is_totp_enabled")
  totpSecret          String?              @map("totp_secret")
  isVerified          Boolean              @default(false) @map("is_verified")
  isEmailVerified     Boolean              @default(false) @map("is_email_verified")
  isDeactivated       Boolean              @default(false) @map("is_deactivated")
  deactivatedAt       DateTime?            @map("deactivated_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  chatMessages        ChatMessage[]
  followers           Follow[]             @relation("followers")
  followings          Follow[]             @relation("followings")
  notification        Notification[]
  notificationSetting NotificationSetting?
  telegramChatId      String?              @map("telegram_chat_id")

  @@map("users")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id")
  isRead    Boolean          @default(false) @map("is_read")
  text      String
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime?        @updatedAt @map("updated_at")

  @@map("notifications")
}

model NotificationSetting {
  id                          String    @id @default(uuid())
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                      String    @unique @map("user_id")
  siteNotificationEnabled     Boolean   @default(true) @map("site_notification_enabled")
  telegramNotificationEnabled Boolean   @default(false) @map("telegram_notification_enabled")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime? @updatedAt @map("updated_at")

  @@map("notification_settings")
}

model Token {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")

  @@map("tokens")
}

model SocialLink {
  id        String    @id @default(uuid())
  title     String    @map("title")
  url       String
  order     Int       @map("order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@map("social_links")
}

model Stream {
  id           String        @id @default(uuid())
  title        String
  thumbnailUrl String?       @map("thumbnail_url")
  ingressId    String?       @unique @map("ingress_id")
  serverUrl    String?       @map("server_url")
  streamKey    String?       @map("stream_key")
  isLive       Boolean       @default(false) @map("is_live")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String        @unique @map("user_id")
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?       @map("category_id")
  chatMessages ChatMessage[]

  @@map("streams")
}

model Category {
  id           String   @id @default(uuid())
  title        String   @unique
  slug         String   @unique
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  streams      Stream[]

  @@map("categories")
}

model ChatMessage {
  id        String    @id @default(uuid())
  text      String
  stream    Stream    @relation(fields: [streamId], references: [id])
  streamId  String    @map("stream_id")
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("chat_messages")
}

model Follow {
  id String @id @default(uuid())

  follower    User   @relation(name: "followers", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String @map("follower_id")
  following   User   @relation(name: "followings", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String @map("following_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

enum TokenType {
  EMAIL_VERIFY
  TELEGRAM_VERIFY
  RESET_PASSWORD
  DEACTIVATE_ACCOUNT

  @@map("token_types")
}

enum NotificationType {
  NEW_FOLLOWER
  ENABLE_TWO_FACTOR
  VERIFIED_CHANNEL
  STREAM_START

  @@map("notification_types")
}
